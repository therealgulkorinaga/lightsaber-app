{
  "name": "lightsaber-backoffice",
  "private": true,
  "version": "0.1.0",
  "description": "Lightsaber Backoffice: authors, reviews, versions and ships the Lightsaber seam",
  "workspaces": [
    "packages/*",
    "server",
    "web"
  ],
  "scripts": {
    "db:create": "createdb lightsaber_backoffice 2>/dev/null || true",
    "db:drop": "dropdb --if-exists lightsaber_backoffice",
    "db:migrate": "npm run -w server migrate",
    "db:seed": "npm run -w server seed",
    "db:reset": "npm run db:drop && npm run db:create && npm run db:migrate && npm run db:seed",
    "dev:server": "npm run -w server dev",
    "dev:web": "npm run -w web dev",
    "test": "npm run -w server test"
  },
  "engines": {
    "node": ">=20"
  }
}
